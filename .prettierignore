pnpm-lock.yaml

# Prettier parses .mdx as markdown, so a JSX comment `{/* ... */}` comes back
# as `{/_ ... _/}` with its indentation flattened. The VIDEO_SPEC blocks in
# docs are written that way, so formatting these files destroys them. Prose
# still gets checked by vale, cspell and case-police.
*.mdx

# The video rig is never formatted: mock fixtures must stay byte-identical to
# their .pristine twins (prettier skips .pristine, so formatting desyncs the
# pair), and editor beats target exact line:column coordinates in them.
video/
